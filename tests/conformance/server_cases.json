{
  "schemaVersion": 1,
  "protocolVersion": "2025-06-18",
  "description": "Black-box JSON-RPC/MCP cases for any newline-delimited moonbit_mcp server",
  "cases": [
    {
      "id": "initialize-integer-id",
      "input": {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"conformance","version":"1.0"}}},
      "expect": {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18"}}
    },
    {
      "id": "initialize-string-id",
      "input": {"jsonrpc":"2.0","id":"init-a","method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"conformance","version":"1.0"}}},
      "expect": {"jsonrpc":"2.0","id":"init-a","result":{"protocolVersion":"2025-06-18"}}
    },
    {
      "id": "initialized-notification",
      "input": {"jsonrpc":"2.0","method":"notifications/initialized"},
      "noResponse": true
    },
    {
      "id": "ping-empty-params",
      "input": {"jsonrpc":"2.0","id":2,"method":"ping","params":{}},
      "expect": {"jsonrpc":"2.0","id":2,"result":{}}
    },
    {
      "id": "ping-no-params",
      "input": {"jsonrpc":"2.0","id":"ping","method":"ping"},
      "expect": {"jsonrpc":"2.0","id":"ping","result":{}}
    },
    {
      "id": "tools-list",
      "input": {"jsonrpc":"2.0","id":3,"method":"tools/list"},
      "expect": {"jsonrpc":"2.0","id":3,"result":{"tools":[]}},
      "ignoreArrayContentsAt": ["result.tools"]
    },
    {
      "id": "echo-string",
      "input": {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"echo","arguments":{"message":"hello"}}},
      "expect": {"jsonrpc":"2.0","id":4,"result":{"isError":false,"content":[{"type":"text"}]}},
      "ignoreArrayContentsAt": ["result.content"]
    },
    {
      "id": "echo-unicode",
      "input": {"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"echo","arguments":{"message":"你好，MoonBit 🌙"}}},
      "expect": {"jsonrpc":"2.0","id":5,"result":{"isError":false}}
    },
    {
      "id": "echo-empty-arguments",
      "input": {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"echo","arguments":{}}},
      "expect": {"jsonrpc":"2.0","id":6,"result":{"isError":false}}
    },
    {
      "id": "unknown-tool",
      "input": {"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"missing","arguments":{}}},
      "expect": {"jsonrpc":"2.0","id":7,"error":{"code":-32602}}
    },
    {
      "id": "unknown-method",
      "input": {"jsonrpc":"2.0","id":8,"method":"not/a/method"},
      "expect": {"jsonrpc":"2.0","id":8,"error":{"code":-32601}}
    },
    {
      "id": "resources-list",
      "input": {"jsonrpc":"2.0","id":9,"method":"resources/list"},
      "expect": {"jsonrpc":"2.0","id":9,"result":{"resources":[]}}
    },
    {
      "id": "resource-missing",
      "input": {"jsonrpc":"2.0","id":10,"method":"resources/read","params":{"uri":"memory://missing"}},
      "expect": {"jsonrpc":"2.0","id":10,"error":{"code":-32602}}
    },
    {
      "id": "prompts-list",
      "input": {"jsonrpc":"2.0","id":11,"method":"prompts/list"},
      "expect": {"jsonrpc":"2.0","id":11,"result":{"prompts":[]}}
    },
    {
      "id": "prompt-missing",
      "input": {"jsonrpc":"2.0","id":12,"method":"prompts/get","params":{"name":"missing","arguments":{}}},
      "expect": {"jsonrpc":"2.0","id":12,"error":{"code":-32602}}
    }
  ]
}
